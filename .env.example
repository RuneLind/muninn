# ============================================================
# Production — real Telegram/Slack bots, scheduler, voice
# ============================================================

# Per-bot tokens (one pair per bot folder in bots/<name>/)
TELEGRAM_BOT_TOKEN_JARVIS=your-jarvis-bot-token
TELEGRAM_ALLOWED_USER_IDS_JARVIS=123456789
# TELEGRAM_BOT_TOKEN_JIRA_ASSISTANT=your-jira-assistant-bot-token
# TELEGRAM_ALLOWED_USER_IDS_JIRA_ASSISTANT=123456789

# Slack (optional — per bot, needs both tokens)
# SLACK_BOT_TOKEN_JARVIS=xoxb-...
# SLACK_APP_TOKEN_JARVIS=xapp-...
# SLACK_ALLOWED_USER_IDS_JARVIS=U12345678

# Database (shared by all bots)
DATABASE_URL=postgresql://muninn:muninn@127.0.0.1:5435/muninn

# Dashboard
DASHBOARD_PORT=3010
# Bind address. Defaults to loopback (the dashboard has no auth). Set to
# 0.0.0.0 to expose on the LAN (trusted home network only). docker-compose
# already overrides this to 0.0.0.0 inside the container.
# DASHBOARD_HOST=127.0.0.1

# Auth. `off` (default) is today's muninn: no middleware, no tokens, the user
# dropdown. `local` puts ONE pinned identity behind a shared secret — the right
# shape when a single human's instance is reachable beyond loopback (e.g. a
# `tailscale serve` publishing 127.0.0.1:3010 to a tailnet). `entra` is the NAV
# path and currently REFUSES to boot; see src/auth/CLAUDE.md.
#
# In local mode the four non-optional vars below are required and the process
# refuses to start without them. A DIRECT loopback request bypasses auth whatever
# these say, so a wrong secret is not a lockout — BUT that test is on the peer
# address, so it does not hold behind an L4 forward (`tailscale serve --tcp`,
# `ssh -L`, socat, a bare nginx `proxy_pass`), where every client is instead
# granted the pinned identity with no credential; and it does not exist at all
# under docker-compose (DASHBOARD_HOST=0.0.0.0), where a forgotten token IS a
# lockout. Read src/auth/CLAUDE.md before exposing an instance.
# MUNINN_AUTH=local
# MUNINN_LOCAL_TOKEN=  # shared secret, >= 16 chars, e.g. `openssl rand -hex 24`
# MUNINN_LOCAL_USER=me          # the single users.id every session acts as
# MUNINN_LOCAL_NAME=Me            # optional display name
# MUNINN_ADMIN_IDENTS=A123456     # required; INERT in local mode (see src/auth/CLAUDE.md)
# MUNINN_ALLOWED_ORIGINS=https://muninn-host.example-tailnet.ts.net,http://127.0.0.1:3010  # required; not enforced yet

# Claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=120000

# Scheduler (tasks, goal reminders, watchers)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# Voice (macOS only)
WHISPER_MODEL_PATH=./models/ggml-base.en.bin

# Tracing
# TRACING_ENABLED=true
# TRACING_RETENTION_DAYS=7
# PROMPT_SNAPSHOTS_RETENTION_DAYS=3
